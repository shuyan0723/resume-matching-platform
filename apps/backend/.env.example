# 服务端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=resume_match
DB_USERNAME=resume_user
DB_PASSWORD=resume123456

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123456

# JWT 配置
JWT_SECRET=your-jwt-secret-key-change-in-production-please
JWT_EXPIRES_IN=7d

# 应用配置
API_PREFIX=/api
NODE_ENV=development

# 文件上传
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AI 服务配置
AI_PROVIDER=openai
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-3.5-turbo
AI_BASE_URL=
