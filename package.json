{
  "name": "resume-matching-platform",
  "version": "1.0.0",
  "private": true,
  "description": "智能简历分析与岗位匹配平台 (Monorepo)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run start:dev --filter=@app/backend",
    "dev:frontend": "turbo run dev --filter=@app/frontend",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@app/backend",
    "build:frontend": "turbo run build --filter=@app/frontend",
    "lint": "turbo run lint",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,css,md}\" \"packages/**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "turbo run typecheck",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:seed": "turbo run seed --filter=@app/backend"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
